# ---------------------------------------------------------------------------
# MedLink environment. Copy to .env.local and fill in.
# Sarvam runs on prepaid credits; LiveKit Cloud is free tier.
# ---------------------------------------------------------------------------

# LiveKit Cloud (free tier): transport, noise cancellation, SIP.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI (https://dashboard.sarvam.ai) - ONE key, all three stages:
#   STT  saaras:v3-realtime          (realtime WebSocket)
#   LLM  sarvam-105b-conversations
#   TTS  bulbul:v3, speaker "ritu"
# Required. The agent refuses to start without it.
SARVAM_API_KEY=

# Optional: override the Sarvam model IDs (defaults are in src/config.py).
# MEDLINK_LLM_MODEL=sarvam-105b-conversations
# MEDLINK_SARVAM_STT_MODEL=saaras:v3-realtime
# MEDLINK_SARVAM_STT_STREAM_TYPE=balanced   # fast | balanced | simulated
# MEDLINK_SARVAM_TTS_MODEL=bulbul:v3
# MEDLINK_SARVAM_TTS_SPEAKER=ritu

# --- Turn taking ---
# Wait after the caller stops speaking before replying. Lower values reply
# faster but cut in on callers who pause mid-sentence - test on a real call.
# MEDLINK_ENDPOINTING_MIN_DELAY=0.5
# MEDLINK_ENDPOINTING_MAX_DELAY=3.0
# Silence Sarvam's VAD waits before closing an utterance.
# MEDLINK_STT_MIN_SILENCE_MS=1000
# Short transcripts below this confidence are treated as line noise/echo.
# MEDLINK_MIN_TURN_CONFIDENCE=0.6
# Start replying before the turn is confirmed: faster, but talks over callers.
# MEDLINK_PREEMPTIVE_GENERATION=false

# --- Persistence (optional; the agent runs fine without it) ---
# docker compose up -d  then:
# DATABASE_URL=postgresql://medlink:medlink@localhost:5432/medlink
MEDLINK_ENABLE_DB=false
DATABASE_URL=
# Any long random string. Changing it makes returning callers unrecognisable.
MEDLINK_PHONE_HASH_KEY=
# Generate with:
#   uv run python -c "from db.crypto import generate_field_key; print(generate_field_key())"
MEDLINK_FIELD_ENCRYPTION_KEY=
MEDLINK_RETENTION_DAYS=90

# --- Firestore: call summaries for the mobile app ---
# After each call a structured summary is written to Firestore at
# patients/{+91...}/calls/{call_id}. Download a service-account key from
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. It has full admin access: keep it gitignored, never commit it.
MEDLINK_ENABLE_FIRESTORE=false
# Defaults to MEDLINK_FIREBASE_CREDENTIALS.json in the project root.
# MEDLINK_FIREBASE_CREDENTIALS=MEDLINK_FIREBASE_CREDENTIALS.json
# MEDLINK_FIRESTORE_TIMEOUT=10
