# ---------------------------------------------------------------------------
# MedLink environment. Everything here is FREE-TIER - nothing should ever bill.
# Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# LiveKit Cloud (free tier): transport, turn detection, noise cancellation, SIP.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Reasoning LLM: Gemini free tier via Google AI Studio.
# Get a key at https://aistudio.google.com/apikey - no credit card, and this is
# NOT the billed Google Cloud API. Leave blank to fall back to LiveKit Inference.
GOOGLE_API_KEY=

# Speech: Bhashini (free government ULCA/ONDC APIs). https://bhashini.gov.in
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# --- Persistence (optional; the agent runs fine without it) ---
# docker compose up -d  then:
# DATABASE_URL=postgresql://medlink:medlink@localhost:5432/medlink
MEDLINK_ENABLE_DB=false
DATABASE_URL=
# Any long random string. Changing it makes returning callers unrecognisable.
MEDLINK_PHONE_HASH_KEY=
# Generate with:
#   uv run python -c "from db.crypto import generate_field_key; print(generate_field_key())"
MEDLINK_FIELD_ENCRYPTION_KEY=
MEDLINK_RETENTION_DAYS=90

# --- Safety guard ---
# Refuses to construct any provider that costs money. Leave true.
MEDLINK_FREE_TIER_ONLY=true
