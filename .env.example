# ---------------------------------------------------------------------------
# MedLink environment. Copy to .env.local and fill in.
# Sarvam runs on prepaid credits; everything else here is free-tier.
# ---------------------------------------------------------------------------

# LiveKit Cloud (free tier): transport, turn detection, noise cancellation, SIP.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# RENAMED 2026-09-11: GOOGLE_API_KEY is now GEMINI_API_KEY (see below).
# Nothing reads GOOGLE_API_KEY any more - rename it in your .env.local.

# --- Reasoning LLM: fallback chain, tried in this order ---
# Gemini (primary) -> Groq -> Cerebras. Each falls through to the next on a rate
# limit, an API error, or a first token that takes too long. Speech deliberately
# does NOT run here: keeping the LLM off Sarvam leaves Sarvam's rate limit for
# the audio path, which is one call per turn instead of one per sentence.
# A provider with no key is dropped from the chain, so one key is enough to run.
# All three have a free tier.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (no card)
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# Optional: override the model per provider (defaults in src/config.py).
# MEDLINK_GEMINI_MODEL=gemini-3.1-flash-lite
# MEDLINK_GROQ_MODEL=llama-3.3-70b-versatile
# MEDLINK_CEREBRAS_MODEL=gpt-oss-120b
# Seconds to wait for a provider's first token before moving down the chain.
# MEDLINK_LLM_ATTEMPT_TIMEOUT=5.0

# Sarvam AI (https://dashboard.sarvam.ai) - SPEECH ONLY, one key for both:
#   STT  saaras:v3-realtime  (realtime WebSocket)
#   TTS  bulbul:v3
# Required. The agent refuses to start without it.
SARVAM_API_KEY=

# Speech provider. Default "sarvam" = Sarvam STT + TTS, both streaming.
# To use Bhashini instead (free, all 22 languages): set this to "bhashini" and
# fill the BHASHINI_* keys. The LLM stays on Sarvam either way.
MEDLINK_SPEECH_PROVIDER=sarvam
# Optional: override the Sarvam model IDs (defaults are in src/config.py).
# MEDLINK_SARVAM_STT_MODEL=saaras:v3-realtime
# MEDLINK_SARVAM_STT_STREAM_TYPE=balanced   # fast | balanced | simulated
# MEDLINK_SARVAM_TTS_MODEL=bulbul:v3
# MEDLINK_SARVAM_TTS_SPEAKER=ritu
# Speculative LLM calls before the caller's turn ends: faster, but discarded
# calls still count against the LLM provider's rate limit. Set false if the free
# tiers start throttling.
# MEDLINK_PREEMPTIVE_GENERATION=true

# Bhashini (free government ULCA/ONDC APIs). https://bhashini.gov.in
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# --- Persistence (optional; the agent runs fine without it) ---
# docker compose up -d  then:
# DATABASE_URL=postgresql://medlink:medlink@localhost:5432/medlink
MEDLINK_ENABLE_DB=false
DATABASE_URL=
# Any long random string. Changing it makes returning callers unrecognisable.
MEDLINK_PHONE_HASH_KEY=
# Generate with:
#   uv run python -c "from db.crypto import generate_field_key; print(generate_field_key())"
MEDLINK_FIELD_ENCRYPTION_KEY=
MEDLINK_RETENTION_DAYS=90

# --- Safety guard ---
# Refuses to construct any provider that costs money. Leave true.
MEDLINK_FREE_TIER_ONLY=true
